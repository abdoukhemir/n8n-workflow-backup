    {
      "parameters": {
        "jsCode": "// This is a TOOL that the AI Agent can call\n// Name: \"get_product_fields\"\n\nconst odooUrl = $env.ODOO_URL;\nconst db = $env.ODOO_DB;\nconst uid = 2;\nconst password = $env.ODOO_PASSWORD;\n\nconst response = await $fetch(`${odooUrl}/jsonrpc`, {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: {\n    jsonrpc: \"2.0\",\n    method: \"call\",\n    params: {\n      service: \"object\",\n      method: \"execute_kw\",\n      args: [db, uid, password, \"product.product\", \"fields_get\", [[]]]\n    }\n  }\n});\n\nconst fields = response.result;\nconst relevantFields = {};\n\nfor (const [key, info] of Object.entries(fields)) {\n  // Only include fields that are writable and useful for creation\n  if (info.change_default || info.required || ['name', 'type', 'list_price', 'standard_price', 'categ_id', 'taxes_id', 'uom_id'].includes(key)) {\n    relevantFields[key] = {\n      string: info.string,\n      type: info.type,\n      required: info.required,\n      help: info.help || \"\"\n    };\n  }\n}\n\nreturn relevantFields;"
      },
